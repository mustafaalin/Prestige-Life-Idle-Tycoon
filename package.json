{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:v2": "vite --mode v2",
    "build": "vite build",
    "build:v2": "VITE_DEV_MENU=false VITE_ADMOB_TESTING=false VITE_ADMOB_DEBUG_EEA=false vite build --mode v2",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "cap:sync": "npm run build && npx cap sync",
    "cap:sync:v2": "npm run build:v2 && npx cap sync",
    "phone": "node scripts/phone.mjs",
    "backup": "sh scripts/backup-drive.sh",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "sim": "esbuild scripts/sim-economy.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim/sim-economy.mjs --log-level=warning && node node_modules/.cache/sim/sim-economy.mjs",
    "progresscheck": "esbuild scripts/progress-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim/progress-check.mjs --log-level=warning && node node_modules/.cache/sim/progress-check.mjs",
    "savecheck": "esbuild scripts/save-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim/save-check.mjs --log-level=warning && node node_modules/.cache/sim/save-check.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor-firebase/analytics": "^8.5.2",
    "@capacitor-firebase/crashlytics": "^8.5.2",
    "@capacitor/android": "^8.2.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capawesome/capacitor-app-update": "^8.1.1",
    "@fontsource/fredoka": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^13.7.3",
    "@rive-app/canvas-lite": "2.44.2",
    "@supabase/supabase-js": "^2.57.4",
    "@types/howler": "^2.2.12",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.19.0",
    "howler": "^2.2.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
